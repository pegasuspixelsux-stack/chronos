rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time;
    }

    match /leads/{leadId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
          ['propertyId', 'propertyTitle', 'name', 'email', 'phone', 'message', 'status', 'createdAt']
        )
        && request.resource.data.keys().hasAll(
          ['propertyId', 'propertyTitle', 'name', 'email', 'phone', 'message', 'status', 'createdAt']
        )
        && request.resource.data.status == 'new'
        && request.resource.data.propertyId is string && request.resource.data.propertyId.size() > 0 && request.resource.data.propertyId.size() <= 200
        && request.resource.data.propertyTitle is string && request.resource.data.propertyTitle.size() > 0 && request.resource.data.propertyTitle.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 50
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt is timestamp;
    }

    match /qualifiedLeads/{leadId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
          ['acquisitionSource', 'timeframe', 'propertyUsage', 'preferredAreas', 'propertySize',
           'budgetRange', 'name', 'email', 'phone', 'readinessScore', 'leadTemperature', 'status', 'createdAt']
        )
        && request.resource.data.keys().hasAll(
          ['acquisitionSource', 'timeframe', 'propertyUsage', 'preferredAreas', 'propertySize',
           'budgetRange', 'name', 'email', 'phone', 'readinessScore', 'leadTemperature', 'status', 'createdAt']
        )
        && request.resource.data.status == 'new'
        && request.resource.data.acquisitionSource is string && request.resource.data.acquisitionSource.size() > 0 && request.resource.data.acquisitionSource.size() <= 100
        && request.resource.data.timeframe is string && request.resource.data.timeframe.size() > 0 && request.resource.data.timeframe.size() <= 100
        && request.resource.data.propertyUsage is string && request.resource.data.propertyUsage.size() > 0 && request.resource.data.propertyUsage.size() <= 100
        && request.resource.data.preferredAreas is list && request.resource.data.preferredAreas.size() <= 10
        && request.resource.data.propertySize is string && request.resource.data.propertySize.size() > 0 && request.resource.data.propertySize.size() <= 100
        && request.resource.data.budgetRange is string && request.resource.data.budgetRange.size() > 0 && request.resource.data.budgetRange.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 50
        && request.resource.data.readinessScore is int && request.resource.data.readinessScore >= 0 && request.resource.data.readinessScore <= 100
        && request.resource.data.leadTemperature in ['hot', 'warm']
        && request.resource.data.createdAt is timestamp;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(
          ['logoUrl', 'businessName', 'address', 'phone', 'whatsappNumber', 'contactEmail', 'businessHours']
        )
        && request.resource.data.logoUrl is string && request.resource.data.logoUrl.size() <= 2000
        && request.resource.data.businessName is string && request.resource.data.businessName.size() <= 200
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 50
        && request.resource.data.whatsappNumber is string && request.resource.data.whatsappNumber.size() <= 50
        && request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 200
        && request.resource.data.businessHours is string && request.resource.data.businessHours.size() <= 200;
    }

    match /salespeople/{salespersonId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'active', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp;
      allow delete: if isAdmin();
    }

    match /advisorRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
          ['propertyId', 'propertyTitle', 'name', 'whatsapp', 'salespersonName', 'status', 'createdAt']
        )
        && request.resource.data.keys().hasAll(
          ['propertyId', 'propertyTitle', 'name', 'whatsapp', 'salespersonName', 'status', 'createdAt']
        )
        && request.resource.data.status == 'new'
        && request.resource.data.propertyId is string && request.resource.data.propertyId.size() > 0 && request.resource.data.propertyId.size() <= 200
        && request.resource.data.propertyTitle is string && request.resource.data.propertyTitle.size() > 0 && request.resource.data.propertyTitle.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() > 0 && request.resource.data.whatsapp.size() <= 50
        && request.resource.data.salespersonName is string && request.resource.data.salespersonName.size() > 0 && request.resource.data.salespersonName.size() <= 200
        && request.resource.data.createdAt is timestamp;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
